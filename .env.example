# Marketing scripts (set these in Vercel env vars to activate)
# All optional — site renders fine without them.

# Google Tag (gtag.js) — enables Google Ads conversion tracking + GA4
# Format: G-XXXXXXXXXX (GA4) or AW-XXXXXXXXX (Google Ads)
# Default is hardcoded to AW-18147937800 in code; only set this to override.
NEXT_PUBLIC_GTAG_ID=

# Google Ads conversion label for the "Book X-Ray" conversion action.
# Format: e.g. "AbC-D_efG12hIjkLmNo"
# Without this, /thanks-xray records the booking in Plausible but does NOT
# report the conversion to Google Ads. Create the conversion action in
# Google Ads → Tools → Conversions, then paste the label here and redeploy.
NEXT_PUBLIC_GADS_CONVERSION_LABEL=

# Meta (Facebook) Pixel ID, e.g. "1234567890"
NEXT_PUBLIC_META_PIXEL_ID=

# LinkedIn Insight Tag Partner ID, e.g. "1234567"
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
